      { "name": "购买物品", "eventKey": "slay_the_spire_2.item_purchased", "commandId": "slay-the-spire-2-item-purchased" },
      { "name": "升级卡牌", "eventKey": "slay_the_spire_2.card_upgraded", "commandId": "slay-the-spire-2-card-upgraded" },
      { "name": "移除卡牌", "eventKey": "slay_the_spire_2.card_removed", "commandId": "slay-the-spire-2-card-removed" },
      { "name": "选择奖励", "eventKey": "slay_the_spire_2.reward_selected", "commandId": "slay-the-spire-2-reward-selected" },
