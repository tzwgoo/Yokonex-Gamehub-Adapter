      { "name": "获得遗物", "eventKey": "slay_the_spire.relic_gained", "commandId": "slay-the-spire-relic-gained" },
      { "name": "获得药水", "eventKey": "slay_the_spire.potion_gained", "commandId": "slay-the-spire-potion-gained" },
      { "name": "金币变化", "eventKey": "slay_the_spire.gold_changed", "commandId": "slay-the-spire-gold-changed" }
